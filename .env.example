# ==============================================================================
# EKİM DEMİRCİ WEB SİTESİ - ÇEVRE DEĞİŞKENLERİ ŞABLONU (.env)
# ==============================================================================
# Canlıya (Vercel) dağıtırken bu değişkenleri Vercel Dashboard -> Settings -> Environment Variables
# bölümüne ekleyebilirsiniz. Yerel ortamda çalıştırmak için bu dosyayı ".env" olarak kopyalayın.

# ------------------------------------------------------------------------------
# 1. VERİTABANI AYARLARI (PostgreSQL - Supabase / Neon / Vercel Postgres)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]?schema=public"

# ------------------------------------------------------------------------------
# 2. E-POSTA BİLDİRİM AYARLARI (Nodemailer / Gmail SMTP)
# ------------------------------------------------------------------------------
# Formlardan gelen mesajların e-postanıza düşmesi için gereklidir.
# Gmail kullanıyorsanız:
# 1. Google Hesabınızda 2 Adımlı Doğrulamayı açın.
# 2. https://myaccount.google.com/apppasswords adresinden "Uygulama Şifresi" (16 haneli) oluşturun.
# 3. SMTP_PASS alanına bu 16 haneli uygulama şifresini yazın (normal Google şifrenizi değil!).

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="ekmdmrci@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="ekmdmrci@gmail.com"
CONTACT_EMAIL="ekmdmrci@gmail.com"

# ------------------------------------------------------------------------------
# 3. OPSİYONEL WEBHOOK (Discord / Telegram / Slack)
# ------------------------------------------------------------------------------
# E-posta yerine veya e-postaya ek olarak anlık Discord / Slack bildirimi almak isterseniz:
# CONTACT_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# ------------------------------------------------------------------------------
# 4. YÖNETİCİ PANELİ GİRİŞ BİLGİLERİ (Admin Dashboard)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAIL="admin@ekimdemirci.com"
NEXT_PUBLIC_ADMIN_PASSWORD="admin123"
